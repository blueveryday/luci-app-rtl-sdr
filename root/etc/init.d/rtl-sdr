#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/rtl_tcp
CONF=rtl_tcp
SECTION=main

start_service() {
	[ -n "${IPKG_INSTROOT:-}" ] && return 0

	local disabled respawn device_index address port frequency gain samplerate buffers num_linked_lists ppm_error
	config_load "$CONF"
	config_get disabled "$SECTION" disabled '0'
	config_get respawn "$SECTION" respawn '1'
	config_get device_index "$SECTION" device_index ''
	config_get address "$SECTION" address '0.0.0.0'
	config_get port "$SECTION" port '1234'
	config_get frequency "$SECTION" frequency ''
	config_get gain "$SECTION" gain ''
	config_get samplerate "$SECTION" samplerate '1024000'
	config_get buffers "$SECTION" buffers '8'
	config_get num_linked_lists "$SECTION" num_linked_lists '8'
	config_get ppm_error "$SECTION" ppm_error ''

	if [ "$disabled" = "1" ]; then
		logger -t rtl_tcp "disabled in /etc/config/rtl_tcp"
		return 0
	fi

	if [ ! -x "$PROG" ]; then
		logger -t rtl_tcp "executable not found: $PROG"
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG"

	[ -n "$address" ] && procd_append_param command -a "$address"
	[ -n "$port" ] && procd_append_param command -p "$port"
	[ -n "$samplerate" ] && procd_append_param command -s "$samplerate"
	[ -n "$frequency" ] && procd_append_param command -f "$frequency"
	[ -n "$gain" ] && procd_append_param command -g "$gain"
	[ -n "$device_index" ] && procd_append_param command -d "$device_index"
	[ -n "$buffers" ] && procd_append_param command -b "$buffers"
	[ -n "$num_linked_lists" ] && procd_append_param command -n "$num_linked_lists"
	[ -n "$ppm_error" ] && procd_append_param command -P "$ppm_error"

	if [ "$respawn" = "1" ]; then
		procd_set_param respawn 3600 5 5
	fi

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}

reload_service() {
	stop
	start
}